{
  "name": "@iris/companion",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/companion.mjs",
    "build:install": "esbuild install/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/install-macos.mjs",
    "install:host": "npm run build && npm run build:install && node dist/install-macos.mjs",
    "uninstall:host": "npm run build:install && node dist/install-macos.mjs --uninstall",
    "check:presage": "esbuild scripts/check-presage.ts --bundle --platform=node --format=esm --target=node20 --external:@smartspectra/* --outfile=dist/check-presage.mjs && node dist/check-presage.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@iris/protocol": "file:../packages/protocol",
    "@smartspectra/node-sdk": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
