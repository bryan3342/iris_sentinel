{
  "name": "iris",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "extension"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @iris/extension",
    "dev:ext": "npm run dev:ext -w @iris/extension",
    "build": "npm run build -w @iris/extension",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "voice:lines": "node --env-file=server/.dev.vars scripts/generate-voice-lines.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "happy-dom": "20.14.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
