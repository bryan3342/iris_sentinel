# Copy this file to .dev.vars and replace the placeholder locally.
GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-3.8-flash
ENABLE_PAGE_UNDERSTANDING=true
# Set to true once the Google account checks in docs/gemini-live-runbook.md are recorded.
PAGE_CONTENT_APPROVED=false
# The Iris extension (its ID is pinned in the manifest). Its requests on this computer need no token.
EXTENSION_ORIGIN=chrome-extension://bohipliohnmknfglnkhglngbmpiahdcn
# Only for a server reached from another computer: operator-issued tokens as
# session ID -> {tokenHash, expiresAt}. No raw tokens.
DEMO_SESSIONS={}
# Voice sessions are independent of page understanding and disabled by default.
ENABLE_VOICE_AGENT=false
ELEVENLABS_API_KEY=replace_with_your_key
ELEVENLABS_AGENT_ID=agent_replace_with_your_agent_id
