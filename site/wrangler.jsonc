// Landing page Worker. Static assets only, no script.
// Cloudflare Workers Builds runs from this directory: `npx wrangler deploy` on main,
// `npx wrangler preview` on every other branch. The `previews` block is required for
// the latter and may stay empty because the page needs no per-branch settings.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "iris-sentinel",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./",
    "not_found_handling": "none"
  },
  "previews": {}
}
